MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61b5fd7005882dc47b61f8d879df88de, type: 3}
  m_Name: HeroDisplayTable
  m_EditorClassIdentifier: Core::HeroDisplayTableSO
  heroes:
  - heroKey: Assassin
    baseHp: 28
    baseDamage: 1.8
    story: "Dashes through enemies while briefly invisible and teleports short distances. Ultimate: an unstoppable, damage-immune blade storm."
  - heroKey: Barbarian
    baseHp: 42
    baseDamage: 2
    story: "Passive: deals up to 3x damage the lower health drops. Ground slams burn the floor over time, and the Ultimate fires projectiles in every direction."
  - heroKey: BloodMage
    baseHp: 26
    baseDamage: 1.6
    story: "Commands a Blood Elemental pet, resummoned every day. Drains blood from nearby enemies to heal, and the Ultimate unleashes an expanding shockwave."
  - heroKey: Cleric
    baseHp: 32
    baseDamage: 3
    story: "Passive: primary attacks deal double damage. Heals in quick pulses, and the Prayer Ultimate curses the surrounding area."
  - heroKey: Druid
    baseHp: 36
    baseDamage: 5
    story: "Summons vines to strike nearby enemies and shifts into an Owl to escape danger. Ultimate: transforms into a powerful Elk."
  - heroKey: Gunslinger
    baseHp: 30
    baseDamage: 1.6
    story: "Passive: all monsters drop double loot. Fires bursts of hitscan shots, and the Ultimate homes in on the nearest enemy."
  - heroKey: Mage
    baseHp: 24
    baseDamage: 2.4
    story: "Commands a Phoenix pet, resummoned every day. Fires a tracking flame attack, and the Ultimate hurls an explosive, burning fireball."
  - heroKey: Paladin
    baseHp: 50
    baseDamage: 2
    story: "Passive: a self-regenerating shield absorbs all damage until it breaks. Throws exploding hammers, and the Ultimate summons orbiting swords."
  - heroKey: Ranger
    baseHp: 30
    baseDamage: 1.6
    story: "Fires a volley of arrows that split their damage, and camouflage grants a slow heal over time. [Pending] New passive idea: damage scales up the longer an arrow has been flying before it hits."
  - heroKey: Rogue
    baseHp: 28
    baseDamage: 3
    story: "Passive: gains 4x Ultimate energy per kill. Leaves a damaging pulse area while free to move, and rolls with full damage immunity."
