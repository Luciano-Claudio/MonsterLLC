  prices:
  - itemName: Monster Essence
    sellValue: 1
    description: "A faint trace of magical residue left behind by a slain monster. Common, but every bit counts."
  - itemName: Monster Fragment
    sellValue: 3
    description: "A small fragment of a monster's body, still humming with leftover energy."
  - itemName: Spirit Dust
    sellValue: 4
    description: "Fine dust left behind when a restless spirit is finally put to rest."
  - itemName: Arcane Shard
    sellValue: 8
    description: "A splinter of crystallized magic, prized by alchemists and enchanters."
  - itemName: Dark Crystal
    sellValue: 10
    description: "A crystal that seems to swallow light instead of reflecting it. Unsettling to hold."
  - itemName: Soul Fragment
    sellValue: 40
    description: "A sliver of a captured soul, still warm with the memory of life."
  - itemName: Corrupted Core
    sellValue: 70
    description: "The twisted heart of a corrupted creature, radiating a faint malice."
  - itemName: Elemental Shard
    sellValue: 300
    description: "A shard torn from a creature made of pure elemental energy."
  - itemName: Ancient Fragment
    sellValue: 500
    description: "A relic fragment far older than anything else found in the Tower."
  - itemName: Infernal Ash
    sellValue: 4000
    description: "Ash from a creature born of flame itself. Still warm to the touch."
  - itemName: Chaos Crystal
    sellValue: 7000
    description: "A crystal pulsing with unstable, chaotic energy. Handle with care."
  - itemName: Nightmare Residue
    sellValue: 750000
    description: "The lingering residue of a creature born from pure nightmare."
  - itemName: Void Shard
    sellValue: 5000000
    description: "A shard of absolute emptiness, torn from the space between worlds."
  - itemName: Celestial Fragment
    sellValue: 10000000000
    description: "A fragment that fell from somewhere far beyond the sky."
  - itemName: Divine Core
    sellValue: 1000000000000
    description: "The very core of something that was never meant to die."
